{# def data, columns=[], order=[], empty_message=None, info_message=None, searching=True, buttons=[], paging=True, page_length=25, length_change=True, buttons_cfg={}, layout='all', server_side=False, state_save=True, auto_width=False, responsive=False, rowgroup=False, fixed_header=False, scroll_y=False #}
{# djlint:off #}
{% set language = {
  "url": url_for('language', get_translation().locale | string),
  "info": info_message or (_('Showing from _START_ to _END_ of _TOTAL_ total records') if paging else _('Showing total of _TOTAL_ records')),
  "emptyTable": empty_message or _('List is empty'),
} %}
{% set predefined_layout={
  "search": {
    'topStart': 'buttons',
    'topEnd': ['pageLength', 'info'],
    'bottom': 'paging',
    'bottomEnd': None,
    'bottomStart': None
  },
  "without-header": {
    'topStart': None,
    'topEnd': None,
    'bottom': 'paging',
    'bottomEnd': None,
    'bottomStart': None
  },
  "without-paging": {
    'topStart': None,
    'topEnd': None,
    'bottomEnd': None,
    'bottomStart': None
  },
  "all": {
    'topStart': {
        'features': ['pageLength', 'info']
    },
    'topEnd': {
        'features': ['search', 'buttons']
    },
    'bottom': 'paging',
    'bottomEnd': None,
    'bottomStart': None
  }
} %}
{% set buttons_cfg = buttons_cfg or {"dom": {"button": {"className": "btn btn-sm btn-outline-secondary ms-1 mb-1 " } } } %}
{# djlint:on #}
<cf:Datatable :data="data"
              :columns="columns"
              :order="order"
              :language="language"
              :searching="searching"
              :buttons="buttons"
              :paging="paging"
              :page_length="page_length"
              :length_change="length_change"
              :buttons_cfg="buttons_cfg"
              :layout="predefined_layout.get(layout|string, layout)"
              :server_side="server_side"
              :state_save="state_save"
              :auto_width="auto_width"
              :responsive="responsive"
              :rowgroup="rowgroup"
              :fixed_header="fixed_header"
              :scroll_y="scroll_y" />
